
generator client {
  provider = "prisma-client"
  output   = "../src/generated"
  // output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum DifficultyLevel {
  VERY_EASY
  EASY
  MEDIUM
  DIFFICULT
  VERY_DIFFICULT
}

enum LernpfadDifficulty {
  ANFAENGER
  FORTGESCHRITTEN
  PRO
}

enum QuestionKind {
  MC_SINGLE
  FILL_BLANK
  SHORT_TEXT
  MATH
  DRAG_DROP
  H5P
}

enum JournalEntryStatus {
  DRAFT
  READY
  REVISE
  ACCEPTED
}

enum JournalEventKind {
  COMMENT
  SUBMITTED
  REVISION_REQUESTED
  ACCEPTED
}

enum NotificationKind {
  JOURNAL_SUBMITTED
  JOURNAL_RESUBMITTED
  JOURNAL_ACCEPTED
  JOURNAL_REVISION_REQUESTED
  JOURNAL_COMMENT
  JOURNAL_FINAL_GRADE
  EXERCISE_REVIEW_NEEDED // teacher: a student has short answers waiting for review
  EXERCISE_REVIEWED // student: the teacher graded their short answers
  ACCOUNT_NOTICE // message from a teacher about the student's account (e.g. name changed)
}

enum RubricLevel {
  NOT_MET
  PARTIAL
  MET
  EXCEEDED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  NEEDS_REVIEW
  GRADED
}


model MathEditorDocument {
  id          String    @id @default(uuid())
  name        String
  head        String?
  data        Json      @db.Json // Assuming data is JSON format
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}


model User {
  id            String    @id @default(cuid())
  name          String
  slug          String?   @unique   // 👈 used in URL
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]


  isTeacher   Boolean?
  isAdmin     Boolean?

  jahrgang    String?
  klasse      String?
  teacherRequestedAt DateTime? // "Ich bin Lehrkraft" at profile completion; cleared when an admin sets the role
  approvedAt  DateTime? // set on signup for school emails, otherwise by a teacher/admin; null = waiting for approval

  userFachExperiences UserFachExperience[] // Add this relation
  awardedPoints AwardedPoints[] // Add this relation
  attachments  Attachment[] // Relation field for attachments to quest

  ownedLearningPaths           LearningPath[]                 @relation("LearningPathOwner")
  learningPathEnrollments      LearningPathEnrollment[]
  learningPathStepCompletions  LearningPathStepCompletion[]
  learningPathCompletions      LearningPathCompletion[]
  exerciseAttempts             ExerciseAttempt[]

  sharedCourses                Course[]                       @relation("CourseShares")

  journalEntries               JournalEntry[]
  journalEvents                JournalEvent[]
  finalAssessments             FinalAssessment[]              @relation("FinalAssessmentStudent")
  gradedAssessments            FinalAssessment[]              @relation("FinalAssessmentGrader")
  notifications                Notification[]                 @relation("NotificationRecipient")
  triggeredNotifications       Notification[]                 @relation("NotificationActor")
  conversations                Conversation[]                 @relation("ConversationStudent")
  directConversations          Conversation[]                 @relation("ConversationTeacher")
  messages                     Message[]                      @relation("MessageAuthor")
  conversationReads            ConversationRead[]
  profileChanges               ProfileChange[]                @relation("ProfileChangeSubject")
  profileChangesMade           ProfileChange[]                @relation("ProfileChangeActor")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}



model Course {
  id String @id @default(uuid())
  userId String
  title String @db.Text
  description String? @db.Text
  longDescription String? @db.Text

  slug String? @unique
  fileKey String? @db.Text

  prerequisites String? @db.Text
  vorkenntnisse String? @db.Text
  kompetenzen String? @db.Text
  imageUrl String? @db.Text
  // price Float?
  // level Int?
  schwierigkeit DifficultyLevel? @default(EASY)
  klassenstufe Int?
  isPublished Boolean @default(false)


  // categoryId String?
  // category Category? @relation(fields: [categoryId], references: [id])
  faecher Fach[] // Define the many-to-many relationship with Fach
  categories Category[] // Define the many-to-many relationship with Category

  awardedPoints AwardedPoints[] // Add this relation

  chapters Chapter[]
  exercises Exercise[]
  attachments Attachment[]
  purchases Purchase[]
  // requirements String[] // List of requirements for the course


  gradings Grading[]

  learningPathSteps LearningPathStep[]

  sharedWith User[] @relation("CourseShares")

  journalEntryXp   Int               @default(10) // XP per accepted journal entry
  journalEntries   JournalEntry[]
  rubricCriteria   RubricCriterion[]
  finalAssessments FinalAssessment[]
  notifications    Notification[]
  conversations    Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  // @@fulltext([title])
  // @@map("course")
}

model Chapter {
  id String @id @default(uuid())
  title String
  description String? @db.Text
  descriptionEditor Json? @db.Json
  mathEditor Json? @db.Json // Assuming data is JSON format
  videoUrl String? @db.Text
  position Int
  isPublished Boolean @default(false)
  isFree Boolean @default(false)

  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userProgress UserProgress[]
  journalEntries JournalEntry[]
  exercise       Exercise? // container for inline questions in this chapter

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  // @@map("chapter")
}

model Exercise {
  id           String   @id @default(uuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  description  String?  @db.Text
  intro        Json?    @db.Json
  position     Int
  isPublished  Boolean  @default(false)
  isFree       Boolean  @default(false)
  passingScore Int?
  awardXp      Boolean  @default(false) // deprecated: replaced by xpReward
  xpReward     Int      @default(0) // XP per Fach when completed, scaled by the share of points
  /// Set for the hidden container that holds a chapter's inline questions.
  chapterId    String?  @unique
  chapter      Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions    ExerciseQuestion[]
  attempts     ExerciseAttempt[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([courseId])
}

model ExerciseQuestion {
  id          String       @id @default(uuid())
  exerciseId  String
  exercise    Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  kind        QuestionKind
  prompt      Json         @db.Json
  spec        Json         @db.Json
  solution    Json         @db.Json
  explanation Json?        @db.Json
  points      Int          @default(1)
  position    Int
  archivedAt  DateTime? // removed from its chapter; kept for existing answers
  responses   ExerciseResponse[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([exerciseId])
}

model ExerciseAttempt {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  totalScore  Int           @default(0)
  maxScore    Int           @default(0)
  status      AttemptStatus @default(IN_PROGRESS)
  xpAwarded   Int           @default(0)
  xpAwardedAt DateTime?
  responses   ExerciseResponse[]

  @@unique([userId, exerciseId])
  @@index([exerciseId])
  @@index([userId])
}

model ExerciseResponse {
  id          String           @id @default(uuid())
  attemptId   String
  attempt     ExerciseAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    ExerciseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer      Json             @db.Json
  tries       Int              @default(0) // how often "Prüfen" was used
  firstTryScore Int? // points of the first check; only these count
  correct     Boolean? // result of the latest check
  checkedAt   DateTime? // first check
  autoScore   Int?
  finalScore  Int?
  feedback    Json?
  needsReview Boolean          @default(false)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model Attachment {
  id String @id @default(uuid())
  name String
  url String @db.Text

  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade )

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade )

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  // @@map("attachment")
}

model UserProgress{
  id String @id @default(uuid())
  userId String

  chapterId String
  // chapterId String @unique
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)  

  isCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chapterId])
  @@unique([userId, chapterId])
  // @@map("userprogress")
}


model Fach {
  id String @id @default(uuid())
  name String @unique

  userFachExperiences UserFachExperience[] // Add this relation
  awardedPoints AwardedPoints[] // Add this relation

  courses Course[]

  @@index([id]) // Adding index for the fachId relation in UserFachExperience
  // @@map("fach")
}

model Category {
  id String @id @default(uuid())
  name String @unique
  courses Course[]
  // @@map("category")
}




model UserFachExperience {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fachId      String
  fach        Fach     @relation(fields: [fachId], references: [id], onDelete: Cascade)
  experience  Int      @default(0)
  level       Int?     @default(1)  // Add level field to track user level per Fach


  @@unique([userId, fachId]) // Ensure a user can only have one entry per Fach
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId]) // Adding index for userId to optimize querying
  @@index([fachId]) // Adding index for fachId to optimize querying
  // @@map("userfachexperience") 
}


model AwardedPoints {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fachId      String
  fach        Fach     @relation(fields: [fachId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  points      Int
  awardedAt   DateTime @default(now())

  @@unique([userId, fachId, courseId]) // Ensure points are only awarded once per course

  @@index([userId]) // Adding index for userId to optimize querying
  @@index([fachId]) // Adding index for fachId to optimize querying
  @@index([courseId]) // Adding index for fachId to optimize querying
  // @@map("awardedpoints") 
}


model Purchase {
  id String @id @default(uuid())
  userId String

  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
  // @@map("purchase")
}


model Grading {
  id         String  @id @default(uuid())
  userId     String

  points     Int
  points_awarded Boolean @default(false)

  courseId   String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
  // @@map("grading")
}



model Badge {
  id          String   @id @default(uuid())
  name        String   @unique
  description String? @db.Text
  imageUrl    String

  userBadges   UserBadge[]
  learningPaths LearningPath[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // @@map("badge")
}

model UserBadge {
  id      String   @id @default(uuid())
  userId  String

  badgeId String
  badge   Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, badgeId], name: "unique_user_badge")
  // @@map("userbadge")
}

model LearningPath {
  id          String             @id @default(uuid())
  title       String             @db.Text
  description String?            @db.Text
  slug        String             @unique
  difficulty  LernpfadDifficulty
  ownerId     String
  owner       User               @relation("LearningPathOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  isPublished Boolean            @default(false)
  badgeId     String?
  badge       Badge?             @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  flowData    Json               @db.Json
  steps       LearningPathStep[]
  enrollments LearningPathEnrollment[]
  completions LearningPathCompletion[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([ownerId])
}

model LearningPathStep {
  id             String                       @id @default(uuid())
  learningPathId String
  learningPath   LearningPath   @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position       Int
  bonusXp        Int            @default(0)
  stepCompletions LearningPathStepCompletion[]

  @@unique([learningPathId, position])
  @@unique([learningPathId, courseId])
  @@index([courseId])
}

model LearningPathEnrollment {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPathId   String
  learningPath     LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  currentStepIndex Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([userId, learningPathId])
  @@index([learningPathId])
}

model LearningPathStepCompletion {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPathStepId String
  learningPathStep   LearningPathStep @relation(fields: [learningPathStepId], references: [id], onDelete: Cascade)
  completedAt        DateTime         @default(now())

  @@unique([userId, learningPathStepId])
  @@index([userId])
}

model LearningPathCompletion {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPathId String
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  completedAt    DateTime     @default(now())

  @@unique([userId, learningPathId])
  @@index([learningPathId])
}

model FaqEntry {
  id        String   @id @default(uuid())
  question  String   @db.Text
  answer    String   @db.Text
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

model JournalEntry {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId   String?
  chapter     Chapter?              @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  title       String?
  content     Json                  @db.Json
  status      JournalEntryStatus    @default(DRAFT)
  entryDate   DateTime              @default(now()) // date shown in the timeline
  submittedAt DateTime? // last time the student marked it ready
  xpAwardedAt DateTime?
  attachments JournalAttachment[]
  versions    JournalEntryVersion[]
  events      JournalEvent[]
  notifications Notification[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([courseId, userId, entryDate])
  @@index([courseId, status])
  @@index([userId])
}

model JournalAttachment {
  id        String       @id @default(uuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  url       String       @db.Text
  fileKey   String?
  name      String
  mimeType  String?
  size      Int?
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([entryId])
}

model JournalEntryVersion {
  id          String       @id @default(uuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  version     Int
  title       String?
  content     Json         @db.Json
  attachments Json         @db.Json // snapshot of JournalAttachment rows
  createdAt   DateTime     @default(now())

  @@unique([entryId, version])
}

model JournalEvent {
  id        String           @id @default(uuid())
  entryId   String
  entry     JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind      JournalEventKind
  body      String?          @db.Text
  createdAt DateTime         @default(now())

  @@index([entryId, createdAt])
}

model RubricCriterion {
  id          String        @id @default(uuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  label       String
  description String?       @db.Text
  position    Int
  scores      RubricScore[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([courseId])
}

model FinalAssessment {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation("FinalAssessmentStudent", fields: [userId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  overallLevel RubricLevel?
  comment      String?       @db.Text
  gradedById   String?
  gradedBy     User?         @relation("FinalAssessmentGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt     DateTime?
  scores       RubricScore[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model RubricScore {
  id           String          @id @default(uuid())
  assessmentId String
  assessment   FinalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criterionId  String
  criterion    RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  level        RubricLevel

  @@unique([assessmentId, criterionId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String // recipient
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  kind      NotificationKind
  title     String           @db.Text
  body      String?          @db.Text
  href      String           @db.Text
  courseId  String?
  course    Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  entryId   String?
  entry     JournalEntry?    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([entryId])
}

/// Audit log of name/Klasse/avatar changes, including rejected (blocked) name attempts.
model ProfileChange {
  id        String   @id @default(uuid())
  userId    String // whose profile
  user      User     @relation("ProfileChangeSubject", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String? // who changed it (the user themselves or a teacher)
  actor     User?    @relation("ProfileChangeActor", fields: [actorId], references: [id], onDelete: SetNull)
  field     String // "name" | "klasse" | "image"
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  blocked   Boolean  @default(false) // attempt was rejected by the name rules
  source    String // "onboarding" | "profile" | "teacher"
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Messages of one student with either the teachers of one quest (courseId) or one
/// teacher directly (teacherId). Exactly one of the two is set (checked in the database).
model Conversation {
  id            String             @id @default(uuid())
  courseId      String?
  course        Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId     String?
  teacher       User?              @relation("ConversationTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  studentId     String
  student       User               @relation("ConversationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime           @default(now())
  messages      Message[]
  reads         ConversationRead[]
  createdAt     DateTime           @default(now())

  @@unique([courseId, studentId])
  @@unique([teacherId, studentId])
  @@index([studentId, lastMessageAt])
  @@index([courseId, lastMessageAt])
  @@index([teacherId, lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?        @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([authorId, createdAt])
}

/// How far each participant has read a conversation (for unread counts).
model ConversationRead {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime

  @@id([conversationId, userId])
  @@index([userId])
}
